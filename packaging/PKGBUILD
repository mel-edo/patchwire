# Maintainer: meledo <meledo@duck.com>
pkgname=patchwire
pkgver=0.1.0
pkgrel=1
pkgdesc="PipeWire audio output router with GTK4 UI"
arch=('x86_64')
url="https://github.com/mel-edo/patchwire"
license=('GPL-3.0-or-later')
depends=(
    'pipewire'
    'pipewire-audio'
    'wireplumber'
    'gtk4'
    'libadwaita'
)
makedepends=(
    'rust'
    'cargo'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$pkgname-$pkgver"
    cargo build --release --locked
}

package() {
    cd "$pkgname-$pkgver"

    # binaries
    install -Dm755 target/release/patchwire \
        "$pkgdir/usr/bin/patchwire"
    install -Dm755 target/release/patchwire-gtk \
        "$pkgdir/usr/bin/patchwire-gtk"

    # systemd user service
    install -Dm644 data/patchwire.service \
        "$pkgdir/usr/lib/systemd/user/patchwire.service"

    # desktop entry
    install -Dm644 data/patchwire.desktop \
        "$pkgdir/usr/share/applications/patchwire.desktop"

    # license
    install -Dm644 LICENSE \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}